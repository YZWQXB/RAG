ENV=local
SECRET_KEY=dev-only-secret-change-in-production
DATABASE_URL=postgresql+asyncpg://rag_app:rag_app_pw@localhost:5432/rag
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag
TEST_DATABASE_URL=postgresql+asyncpg://rag_app:rag_app_pw@localhost:5432/rag_test

REDIS_URL=redis://localhost:6379/0

# 存储：local（默认，单机零依赖）| s3（生产必须用 s3，多副本才不会丢入库任务）
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=data/storage

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rag-docs
S3_REGION=us-east-1

# Providers: api | fake
EMBEDDING_PROVIDER=api
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

LLM_PROVIDER=api
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

RERANKER_PROVIDER=api
RERANKER_BASE_URL=https://api.siliconflow.cn/v1
RERANKER_API_KEY=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Retrieval
RETRIEVAL_TOP_DENSE=40
RETRIEVAL_TOP_SPARSE=20
RETRIEVAL_TOP_FUSED=20
RETRIEVAL_TOP_FINAL=6
RETRIEVAL_BUDGET_TOKENS=3000
# 无答案判定阈值：与向量模型强相关，换模型必须重跑 scripts.calibrate_threshold
# bge-m3 实测 可答 p50=0.742 / 不可答 max=0.513 → 0.55 分离度 100%
# 旧的字符袋假向量分布偏低，用 0.35
RETRIEVAL_NO_ANSWER_THRESHOLD=0.55
# 离线词法打分专用阈值（余弦×覆盖率，量纲与向量余弦不同：应作答 0.12~0.43）
RETRIEVAL_NO_ANSWER_THRESHOLD_FAKE=0.10
# 稀疏通道（pg_trgm）单独门槛，兜住精确编号类查询
RETRIEVAL_SPARSE_ANSWER_THRESHOLD=0.35
RETRIEVAL_RERANK_ENABLED=true

# Ingestion
UPLOAD_MAX_BYTES=52428800
# docx 等 zip 容器的解压后体积上限，防解压炸弹
UPLOAD_MAX_UNCOMPRESSED_BYTES=209715200
CHUNK_SIZE_CHARS=600
CHUNK_OVERLAP_CHARS=90
CHUNK_MAX_CHARS=1200
INGEST_MAX_ATTEMPTS=3
# 单文档处理总超时（秒）
INGEST_TIMEOUT_SECONDS=300
# 同时处理的入库文档数
INGEST_MAX_CONCURRENT=2

# 流式回答的心跳间隔（秒），用于穿透 nginx / 网关的空闲超时
SSE_KEEPALIVE_SECONDS=15
# 同一 IP 每分钟允许的登录/换 token 次数，超出返回 429 + Retry-After
LOGIN_RATE_LIMIT_PER_MINUTE=20
REGISTER_RATE_LIMIT_PER_MINUTE=5
# 问答接口按用户限流（每分钟），0 表示关闭
CHAT_RATE_LIMIT_PER_MINUTE=5
# 配额按月重置所使用的时区
QUOTA_TIMEZONE=Asia/Shanghai

# Debug
ENABLE_DEBUG_API=true

# 配额使用比例超过该值时前端标红并告警
QUOTA_WARN_RATIO=0.8
